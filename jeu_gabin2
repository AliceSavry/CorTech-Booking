<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Geometry Dash Kids - Édition 67</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #1a1a1a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            touch-action: manipulation;
        }
        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        canvas {
            display: block;
            box-shadow: 0 0 50px rgba(0,0,0,0.5);
            background: linear-gradient(to bottom, #111a3a, #5c0f1b, #7d5007);
            background-size: 100% 200%;
            animation: gradientBG 15s ease infinite;
            border: 4px solid #333;
            border-radius: 12px;
        }
        @keyframes gradientBG {
            0 { background-position: 0% 0%; }
            50% { background-position: 0% 100%; }
            100% { background-position: 0% 0%; }
        }
        #ui-overlay {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            color: white;
            pointer-events: none;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        #menu-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: white;
            background: rgba(0, 0, 0, 0.85);
            padding: 30px;
            border-radius: 20px;
            border: 2px solid #00ffcc;
            backdrop-filter: blur(8px);
            width: 90%;
            max-width: 450px;
            z-index: 10;
        }
        .btn-main {
            background: #00ffcc;
            color: #000;
            padding: 12px 40px;
            border: none;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.5rem;
            cursor: pointer;
            transition: transform 0.2s, background 0.2s;
            margin-top: 15px;
            pointer-events: auto;
            width: 100%;
        }
        .btn-main:hover {
            transform: scale(1.05);
            background: #00e6b8;
        }
        .config-section {
            margin: 12px 0;
            pointer-events: auto;
        }
        .color-dot {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: inline-block;
            margin: 0 5px;
            cursor: pointer;
            border: 3px solid transparent;
            transition: transform 0.2s;
        }
        .color-dot.active {
            border-color: white;
            transform: scale(1.2);
        }
        .shape-btn {
            background: #333;
            color: white;
            padding: 8px 15px;
            border-radius: 8px;
            margin: 0 5px;
            cursor: pointer;
            border: 2px solid transparent;
            font-size: 0.9rem;
        }
        .shape-btn.active {
            border-color: #00ffcc;
            background: #444;
        }
        .hide {
            display: none !important;
        }
        #progress-bar-container {
            width: 200px;
            height: 10px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 5px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.4);
        }
        #progress-bar {
            height: 100%;
            background: linear-gradient(to right, #00ffcc, #f1c40f);
            width: 0%;
            transition: width 0.1s linear;
        }
    </style>
</head>
<body>

<div id="game-container">
    <canvas id="gameCanvas"></canvas>
    
    <div id="ui-overlay">
        <div>
            <div class="text-2xl font-bold text-cyan-400">Score: <span id="score">0</span> / <span id="targetScore" class="text-yellow-400 font-extrabold">15</span></div>
            <div class="text-sm opacity-80">Record: <span id="highScore">0</span> | <span id="diff-indicator" class="text-emerald-400 font-bold">Facile</span></div>
            <div id="mode-indicator" class="text-xs mt-1 font-mono uppercase tracking-widest text-yellow-400">Mode: 67</div>
        </div>
        <div class="flex flex-col items-end">
            <span class="text-xs uppercase tracking-widest text-white mb-1">Progression</span>
            <div id="progress-bar-container">
                <div id="progress-bar"></div>
            </div>
            <span id="victory-hint" class="text-[10px] text-yellow-300 mt-1">Objectif : Portail d'Or à 15 pts !</span>
        </div>
    </div>

    <div id="menu-overlay">
        <h1 id="menu-title" class="text-3xl font-black mb-2 tracking-widest text-cyan-400 uppercase">Geometry Dash</h1>
        <p id="menu-subtitle" class="text-xs text-slate-300 mb-4">ÉDITION JUNIOR 67</p>
        
        <div class="config-section">
            <p class="text-xs uppercase tracking-widest mb-2 opacity-60 text-slate-200">Difficulté du Niveau</p>
            <div id="difficulty-picker" class="flex justify-center gap-2 mb-3">
                <button class="difficulty-btn active bg-emerald-500 text-slate-950 px-3 py-1.5 rounded-lg text-[10px] font-black tracking-wider uppercase transition-all border border-transparent shadow-lg hover:scale-105" data-difficulty="EASY">FACILE</button>
                <button class="difficulty-btn bg-slate-800 text-slate-300 px-3 py-1.5 rounded-lg text-[10px] font-black tracking-wider uppercase transition-all border border-transparent hover:bg-slate-700 hover:scale-105" data-difficulty="MEDIUM">MOYEN</button>
                <button class="difficulty-btn bg-slate-800 text-slate-300 px-3 py-1.5 rounded-lg text-[10px] font-black tracking-wider uppercase transition-all border border-transparent hover:bg-slate-700 hover:scale-105" data-difficulty="HARD">DIFFICILE</button>
            </div>
        </div>

        <div class="config-section">
            <p class="text-xs uppercase tracking-widest mb-2 opacity-60 text-slate-200">Couleur du Personnage</p>
            <div id="color-picker">
                <div class="color-dot active" style="background: #00ffcc;" data-color="#00ffcc"></div>
                <div class="color-dot" style="background: #a29bfe;" data-color="#a29bfe"></div>
                <div class="color-dot" style="background: #ff7675;" data-color="#ff7675"></div>
                <div class="color-dot" style="background: #55efc4;" data-color="#55efc4"></div>
                <div class="color-dot" style="background: #fab1a0;" data-color="#fab1a0"></div>
            </div>
        </div>

        <div class="config-section">
            <p class="text-xs uppercase tracking-widest mb-2 opacity-60 text-slate-200">Forme au sol</p>
            <div id="shape-picker">
                <button class="shape-btn active" data-shape="SHAPE_67">FORME 67</button>
                <button class="shape-btn" data-shape="CIRCLE">CERCLE</button>
            </div>
        </div>

        <button id="startBtn" class="btn-main">JOUER</button>
        <p class="text-[10px] mt-4 opacity-50 uppercase tracking-tighter text-slate-300">
            Grimpe l'escalier magique et traverse les portails !
        </p>
    </div>
</div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreElement = document.getElementById('score');
    const highScoreElement = document.getElementById('highScore');
    const modeIndicator = document.getElementById('mode-indicator');
    const menuOverlay = document.getElementById('menu-overlay');
    const menuTitle = document.getElementById('menu-title');
    const startBtn = document.getElementById('startBtn');
    const progressBar = document.getElementById('progress-bar');

    const targetScoreElement = document.getElementById('targetScore');
    const diffIndicator = document.getElementById('diff-indicator');
    const victoryHint = document.getElementById('victory-hint');

    const config = {
        gravity: 0.8,
        jumpForce: -12.5, 
        shipThrust: -0.7,
        shipGravity: 0.45,
        speed: 5.5,
        playerSize: 52, // Taille augmentée de 42 à 52 pour un 67 plus imposant !
        groundHeight: 80,
        victoryScore: 10
    };

    let currentDifficulty = 'EASY';

    const difficultySettings = {
        EASY: {
            speed: 5.5,
            victoryScore: 10,
            spawnInterval: 110,
            label: "Facile",
            colorClass: "text-emerald-400",
            bgClass: "bg-emerald-500 text-slate-950"
        },
        MEDIUM: {
            speed: 7.5,
            victoryScore: 15,
            spawnInterval: 80,
            label: "Moyen",
            colorClass: "text-yellow-400",
            bgClass: "bg-yellow-500 text-slate-950"
        },
        HARD: {
            speed: 10.0,
            victoryScore: 25,
            spawnInterval: 60,
            label: "Difficile",
            colorClass: "text-rose-500",
            bgClass: "bg-rose-500 text-slate-950"
        }
    };

    let gameState = 'MENU';
    let score = 0;
    let highScore = localStorage.getItem('gd_highscore_EASY') || 0;
    let isPressing = false;
    let currentGameMode = 'CUBE'; 
    let victoryPortalSpawned = false;
    let nextPortalFrame = 0; 
    let bannerText = "";
    let bannerTimer = 0;
    highScoreElement.textContent = highScore;

    const player = {
        x: 150,
        y: 0,
        vy: 0,
        rotation: 0,
        size: config.playerSize,
        color: '#00ffcc',
        shape: 'SHAPE_67', 
        onGround: false,
        onBlock: false,
        update() {
            if (currentGameMode === 'CUBE') {
                this.vy += config.gravity;
                this.y += this.vy;
                const groundY = canvas.height - config.groundHeight - this.size;
                if (this.y > groundY) {
                    this.y = groundY;
                    this.vy = 0;
                    this.onGround = true;
                    if (this.shape === 'SHAPE_67') {
                        this.rotation = Math.round(this.rotation / 90) * 90;
                    } else {
                        this.rotation += config.speed * 1.5;
                    }
                } else if (!this.onBlock) {
                    this.onGround = false;
                    this.rotation += (this.shape === 'SHAPE_67') ? 6 : 8;
                }
            } else {
                // Mode SHIP
                if (isPressing) this.vy += config.shipThrust;
                else this.vy += config.shipGravity;
                this.vy = Math.max(-9, Math.min(9, this.vy));
                this.y += this.vy;
                this.rotation = this.vy * 4;
                const groundY = canvas.height - config.groundHeight - this.size;
                if (this.y > groundY) {
                    this.y = groundY;
                    this.vy = 0;
                }
                if (this.y < 0) {
                    this.y = 0;
                    this.vy = 0;
                }
            }
        },
        draw() {
            ctx.save();
            ctx.translate(this.x + this.size / 2, this.y + this.size / 2);
            ctx.rotate(this.rotation * Math.PI / 180);
            
            // Appliquer une ombre de lueur néon autour du joueur
            ctx.shadowBlur = 15;
            ctx.shadowColor = this.color;

            if (currentGameMode === 'SHIP') {
                ctx.fillStyle = this.color;
                ctx.strokeStyle = 'white';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(-this.size/2, 0);
                ctx.lineTo(this.size/2, -this.size/3);
                ctx.lineTo(this.size/2, this.size/3);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();
                
                // Petit cockpit
                ctx.fillStyle = 'rgba(255,255,255,0.5)';
                ctx.fillRect(0, -5, 10, 10);
                
                // On imbrique la forme sélectionnée réduite à l'intérieur du cockpit
                ctx.translate(-5, 0);
                ctx.scale(0.5, 0.5);
            }

            if (this.shape === 'SHAPE_67' || currentGameMode === 'SHIP') {
                // RENDER LA SILHOUETTE DU NOMBRE 67 directement
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                // Calcul de la taille de police proportionnel à la taille du joueur
                ctx.font = `900 ${Math.floor(this.size * 1.15)}px 'Impact', 'Segoe UI', Arial, sans-serif`;
                
                // Contour blanc épais pour définir la forme physique du 67
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 8; // Légèrement plus épais pour correspondre à la nouvelle taille
                ctx.lineJoin = 'round';
                ctx.strokeText('67', 0, 0);
                
                // Intérieur avec la couleur néon choisie par le joueur
                ctx.fillStyle = this.color;
                ctx.fillText('67', 0, 0);

                // Petite touche technologique GD (pupilles minimalistes réajustées)
                ctx.fillStyle = '#000000';
                ctx.fillRect(-14, -10, 5, 5);
                ctx.fillRect(10, -10, 5, 5);
            } else {
                ctx.fillStyle = this.color;
                ctx.strokeStyle = 'white';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.arc(0, 0, this.size / 2, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = 'black';
                ctx.beginPath();
                ctx.arc(8, -8, 4, 0, Math.PI * 2);
                ctx.arc(-8, -8, 4, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.restore();
        },
        jump() {
            if (currentGameMode === 'CUBE' && (this.onGround || this.onBlock)) {
                this.vy = config.jumpForce;
                this.onBlock = false;
                this.onGround = false;
            }
        }
    };

    document.querySelectorAll('.color-dot').forEach(dot => {
        dot.addEventListener('click', () => {
            document.querySelectorAll('.color-dot').forEach(d => d.classList.remove('active'));
            dot.classList.add('active');
            player.color = dot.dataset.color;
        });
    });

    document.querySelectorAll('.shape-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.shape-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            player.shape = btn.dataset.shape;
            if (player.shape === 'SHAPE_67') {
                modeIndicator.textContent = "Mode: 67";
            } else {
                modeIndicator.textContent = "Mode: Cercle";
            }
        });
    });

    document.querySelectorAll('.difficulty-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.difficulty-btn').forEach(b => {
                b.classList.remove('active', 'bg-emerald-500', 'bg-yellow-500', 'bg-rose-500', 'text-slate-950');
                b.classList.add('bg-slate-800', 'text-slate-300');
            });
            currentDifficulty = btn.dataset.difficulty;
            btn.classList.add('active');
            btn.classList.remove('bg-slate-800', 'text-slate-300');
            
            const settings = difficultySettings[currentDifficulty];
            if (currentDifficulty === 'EASY') btn.classList.add('bg-emerald-500', 'text-slate-950');
            else if (currentDifficulty === 'MEDIUM') btn.classList.add('bg-yellow-500', 'text-slate-950');
            else if (currentDifficulty === 'HARD') btn.classList.add('bg-rose-500', 'text-slate-950');
            
            highScore = localStorage.getItem('gd_highscore_' + currentDifficulty) || 0;
            highScoreElement.textContent = highScore;
        });
    });

    let obstacles = [];
    let particles = [];
    let portals = [];
    let frameCount = 0;

    class Portal {
        constructor(toMode, xPos = null) {
            this.toMode = toMode; 
            this.width = 60;
            this.height = toMode === 'VICTORY' ? 180 : (toMode === 'DIFFICULTY' ? 40 : 140);
            this.x = xPos !== null ? xPos : canvas.width + 100;
            
            const groundY = canvas.height - config.groundHeight;
            
            if (toMode === 'VICTORY') {
                this.y = groundY - this.height;
                this.color = '#ffd700'; 
            } else if (toMode === 'DIFFICULTY') {
                this.width = 100;
                this.y = groundY - this.height; 
                this.color = '#e67e22'; 
            } else {
                this.y = groundY - this.height;
                this.color = toMode === 'SHIP' ? '#ff00ff' : '#00ff00';
            }
            this.passed = false;
        }
        update() {
            this.x -= config.speed;
        }
        draw() {
            ctx.save();
            ctx.shadowBlur = this.toMode === 'VICTORY' ? 35 : 20;
            ctx.shadowColor = this.color;
            ctx.fillStyle = this.color;
            ctx.globalAlpha = 0.75;
            
            ctx.beginPath();
            ctx.ellipse(this.x + this.width/2, this.y + this.height/2, this.width/2, this.height/2, 0, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.strokeStyle = 'white';
            ctx.lineWidth = this.toMode === 'VICTORY' ? 6 : 4;
            ctx.globalAlpha = 1.0;
            ctx.stroke();

            ctx.strokeStyle = 'white';
            ctx.lineWidth = 2;
            const lines = this.toMode === 'VICTORY' ? 8 : 5;
            for(let i=0; i<lines; i++) {
                let offset = (frameCount * 3 + i * 25) % this.height;
                ctx.beginPath();
                if (this.toMode === 'DIFFICULTY') {
                    let hOffset = (frameCount * 4 + i * 20) % this.width;
                    ctx.moveTo(this.x + hOffset, this.y + 5);
                    ctx.lineTo(this.x + hOffset, this.y + this.height - 5);
                } else {
                    ctx.moveTo(this.x + 5, this.y + offset);
                    ctx.lineTo(this.x + this.width - 5, this.y + offset);
                }
                ctx.stroke();
            }

            if (this.toMode === 'VICTORY') {
                ctx.fillStyle = '#fff';
                for (let i = 0; i < 5; i++) {
                    const angle = (frameCount * 0.05 + i * (Math.PI * 2 / 5));
                    const starX = this.x + this.width/2 + Math.cos(angle) * (this.width/1.5);
                    const starY = this.y + this.height/2 + Math.sin(angle) * (this.height/1.5);
                    ctx.beginPath();
                    ctx.arc(starX, starY, 3 + Math.sin(frameCount * 0.1) * 2, 0, Math.PI * 2);
                    ctx.fill();
                }
            }

            ctx.restore();
        }
    }

    class Obstacle {
        constructor(type, xOffset = 0, yOffset = 0, h = 40, w = 40) {
            this.type = type; 
            this.width = w;
            this.height = h;
            this.x = canvas.width + xOffset;
            this.y = (type === 'CEILING') ? yOffset : (canvas.height - config.groundHeight - this.height) - yOffset;
            this.passed = false;
        }
        update() {
            this.x -= config.speed;
        }
        draw() {
            if (this.type === 'SPIKE') {
                const centerX = this.x + this.width / 2;
                const bottomY = this.y + this.height;
                ctx.fillStyle = '#ff3333';
                ctx.beginPath();
                ctx.moveTo(this.x, bottomY);
                ctx.lineTo(centerX, this.y);
                ctx.lineTo(this.x + this.width, bottomY);
                ctx.fill();
                ctx.strokeStyle = 'white';
                ctx.lineWidth = 1.5;
                ctx.stroke();
            } else if (this.type === 'STAIR') {
                ctx.fillStyle = '#3498db';
                ctx.fillRect(this.x, this.y, this.width, this.height);
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 2.5;
                ctx.strokeRect(this.x + 2, this.y + 2, this.width - 4, this.height - 4);
                
                ctx.strokeStyle = 'rgba(255,255,255,0.4)';
                ctx.beginPath();
                ctx.moveTo(this.x, this.y + 6);
                ctx.lineTo(this.x + this.width, this.y + 6);
                ctx.stroke();
            } else {
                ctx.fillStyle = '#f1c40f';
                ctx.fillRect(this.x, this.y, this.width, this.height);
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 2;
                ctx.strokeRect(this.x + 2, this.y + 2, this.width - 4, this.height - 4);
            }
        }
    }

    class Particle {
        constructor(x, y, color, isVictory = false) {
            this.x = x;
            this.y = y;
            this.vx = (Math.random() - 0.5) * (isVictory ? 15 : 12);
            this.vy = (Math.random() - 0.5) * (isVictory ? 15 : 12) - (isVictory ? 3 : 0);
            this.size = Math.random() * (isVictory ? 8 : 6) + 2;
            this.life = 1.0;
            this.color = color;
            this.isVictory = isVictory;
        }
        update() {
            this.x += this.vx;
            this.y += this.vy;
            if (this.isVictory) {
                this.vy += 0.2; 
            }
            this.life -= this.isVictory ? 0.015 : 0.025;
        }
        draw() {
            ctx.globalAlpha = this.life;
            ctx.fillStyle = this.color;
            ctx.beginPath();
            if (this.isVictory) {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.life * 10);
                ctx.fillRect(-this.size/2, -this.size/2, this.size, this.size * 0.6);
                ctx.restore();
            } else {
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.globalAlpha = 1.0;
        }
    }

    function spawnPattern() {
        if (score >= config.victoryScore && !victoryPortalSpawned) {
            victoryPortalSpawned = true;
            portals.push(new Portal('VICTORY', canvas.width + 150));
            return;
        }

        if (score >= config.victoryScore) return;
        if (portals.some(p => p.x > canvas.width - 250)) return;

        const rand = Math.random();

        if (currentGameMode === 'CUBE') {
            if (frameCount < 200 && portals.length > 0) return; 
            
            if (rand < 0.25) {
                // LE GRAND ESCALIER AUTOMATIQUE AVEC CHUTE ET PORTAIL DE DIFFICULTÉ
                obstacles.push(new Obstacle('STAIR', 0, 0, 30));
                obstacles.push(new Obstacle('STAIR', 40, 0, 60));
                obstacles.push(new Obstacle('STAIR', 80, 0, 90));
                obstacles.push(new Obstacle('STAIR', 120, 0, 120));
                obstacles.push(new Obstacle('STAIR', 160, 0, 150));
                obstacles.push(new Obstacle('STAIR', 200, 0, 150));
                obstacles.push(new Obstacle('STAIR', 240, 0, 150));
                
                portals.push(new Portal('DIFFICULTY', canvas.width + 380));
            } else if (rand < 0.50) {
                obstacles.push(new Obstacle('BLOCK', 0, 0));
                obstacles.push(new Obstacle('BLOCK', 150, 45));
            } else if (rand < 0.75) {
                obstacles.push(new Obstacle('SPIKE', 0, 0));
                obstacles.push(new Obstacle('BLOCK', 150, 60));
            } else {
                obstacles.push(new Obstacle('SPIKE', 0, 0));
                obstacles.push(new Obstacle('SPIKE', 50, 0));
            }
        } else {
            // Mode SHIP (Vaisseau)
            const gapY = Math.random() * (canvas.height - 280) + 40;
            const gapSize = 170;
            obstacles.push(new Obstacle('CEILING', 0, 0, gapY));
            const bottomH = canvas.height - config.groundHeight - (gapY + gapSize);
            if (bottomH > 0) obstacles.push(new Obstacle('BLOCK', 0, 0, bottomH));
        }

        if (frameCount >= nextPortalFrame && frameCount > 200 && rand >= 0.25) {
            const nextMode = currentGameMode === 'CUBE' ? 'SHIP' : 'CUBE';
            portals.push(new Portal(nextMode, null));
            nextPortalFrame = frameCount + 400 + Math.random() * 400; 
        }
    }

    function checkCollision(p, o) {
        const pLeft = p.x + 5; const pRight = p.x + p.size - 5;
        const pTop = p.y + 5; const pBottom = p.y + p.size - 5;
        const oLeft = o.x; const oRight = o.x + o.width;
        const oTop = o.y; const oBottom = o.y + o.height;

        if (pRight > oLeft && pLeft < oRight && pBottom > oTop && pTop < oBottom) {
            if (currentGameMode === 'CUBE' && (o.type === 'BLOCK' || o.type === 'STAIR')) {
                if (o.type === 'STAIR' || pBottom - p.vy <= oTop + 15) {
                    p.y = oTop - p.size; p.vy = 0; p.onBlock = true;
                    if (p.shape === 'SHAPE_67') {
                        p.rotation = Math.round(p.rotation / 90) * 90;
                    }
                    return false; 
                }
            }
            return true; 
        }
        return false;
    }

    function showBannerText(text) {
        bannerText = text;
        bannerTimer = 120; 
    }

    function changeDifficulty(diff) {
        currentDifficulty = diff;
        const settings = difficultySettings[currentDifficulty];
        config.speed = settings.speed;
        config.victoryScore = settings.victoryScore;

        targetScoreElement.textContent = config.victoryScore;
        diffIndicator.textContent = settings.label;
        diffIndicator.className = settings.colorClass + " font-bold";
        victoryHint.textContent = `Objectif : Portail d'Or à ${config.victoryScore} pts !`;

        highScore = localStorage.getItem('gd_highscore_' + currentDifficulty) || 0;
        highScoreElement.textContent = highScore;

        document.querySelectorAll('.difficulty-btn').forEach(b => {
            b.classList.remove('active', 'bg-emerald-500', 'bg-yellow-500', 'bg-rose-500', 'text-slate-950');
            b.classList.add('bg-slate-800', 'text-slate-300');
            if (b.dataset.difficulty === diff) {
                b.classList.add('active');
                b.classList.remove('bg-slate-800', 'text-slate-300');
                if (diff === 'EASY') b.classList.add('bg-emerald-500', 'text-slate-950');
                else if (diff === 'MEDIUM') b.classList.add('bg-yellow-500', 'text-slate-950');
                else if (diff === 'HARD') b.classList.add('bg-rose-500', 'text-slate-950');
            }
        });
    }

    function gameWin() {
        const colors = ['#ffd700', '#ff00ff', '#00ffcc', '#ff7675', '#55efc4', '#ffffff'];
        for (let i = 0; i < 150; i++) {
            const randomColor = colors[Math.floor(Math.random() * colors.length)];
            particles.push(new Particle(player.x + player.size/2, player.y + player.size/2, randomColor, true));
        }

        if (currentDifficulty === 'EASY') {
            setTimeout(() => {
                changeDifficulty('MEDIUM');
                victoryPortalSpawned = false; 
                obstacles = []; 
                portals = [];
                showBannerText("NIVEAU 1 RÉUSSI ! MODE MOYEN (CIBLE : 15)");
            }, 600);
        } else if (currentDifficulty === 'MEDIUM') {
            setTimeout(() => {
                changeDifficulty('HARD');
                victoryPortalSpawned = false; 
                obstacles = [];
                portals = [];
                showBannerText("NIVEAU 2 RÉUSSI ! MODE DIFFICILE (CIBLE : 25)");
            }, 600);
        } else {
            gameState = 'VICTORY';
            setTimeout(() => {
                menuOverlay.classList.remove('hide');
                menuTitle.textContent = "SUPER CHAMPION !";
                menuTitle.className = "text-3xl font-black mb-2 tracking-widest text-yellow-400 uppercase";
                menuSubtitle.textContent = "TU AS BATTU TOUS LES NIVEAUX ! 🏆";
                startBtn.textContent = "RECOMMENCER";
            }, 1200);
        }
    }

    function gameOver() {
        gameState = 'GAMEOVER';
        explode(player.x + player.size/2, player.y + player.size/2, player.color, 40);
        if (score > highScore) {
            highScore = score;
            localStorage.setItem('gd_highscore_' + currentDifficulty, highScore);
            highScoreElement.textContent = highScore;
        }
        setTimeout(() => {
            menuOverlay.classList.remove('hide');
            menuTitle.textContent = "ESSAIE ENCORE !";
            menuTitle.className = "text-3xl font-black mb-2 tracking-widest text-cyan-400 uppercase";
            menuSubtitle.textContent = "ENTRAÎNE-TOI POUR ATTEINDRE LE PORTAIL DE FIN !";
            startBtn.textContent = "RÉESSAYER";
        }, 1000);
    }

    function resetGame() {
        changeDifficulty(currentDifficulty);

        score = 0;
        scoreElement.textContent = score;

        obstacles = [];
        particles = [];
        portals = [];
        currentGameMode = 'CUBE';
        victoryPortalSpawned = false;
        progressBar.style.width = '0%';
        if (player.shape === 'SHAPE_67') {
            modeIndicator.textContent = "Mode: 67";
        } else {
            modeIndicator.textContent = "Mode: Cercle";
        }
        modeIndicator.className = "text-xs mt-1 font-mono uppercase tracking-widest text-yellow-400";
        player.y = canvas.height - config.groundHeight - player.size;
        player.vy = 0;
        player.rotation = 0;
        player.onBlock = false;
        player.onGround = true;
        gameState = 'PLAYING';
        menuOverlay.classList.add('hide');
        frameCount = 0;
        bannerText = "";
        bannerTimer = 0;

        nextPortalFrame = 350 + Math.random() * 250;
    }

    function drawBackground() {
        ctx.fillStyle = '#0a0a0a';
        ctx.fillRect(0, canvas.height - config.groundHeight, canvas.width, config.groundHeight);
        ctx.strokeStyle = currentGameMode === 'CUBE' ? '#00ffcc' : '#ff00ff';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(0, canvas.height - config.groundHeight);
        ctx.lineTo(canvas.width, canvas.height - config.groundHeight);
        ctx.stroke();

        ctx.strokeStyle = 'rgba(255,255,255,0.05)';
        const scroll = (frameCount * config.speed) % 50;
        for(let i = -scroll; i < canvas.width; i += 50) {
            ctx.beginPath();
            ctx.moveTo(i, 0);
            ctx.lineTo(i, canvas.height - config.groundHeight);
            ctx.stroke();
        }
    }

    function update() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        drawBackground();

        if (gameState === 'PLAYING') {
            frameCount++;
            player.update();
            
            const percentage = Math.min(100, (score / config.victoryScore) * 100);
            progressBar.style.width = percentage + '%';

            const settings = difficultySettings[currentDifficulty];
            if (frameCount % settings.spawnInterval === 0) spawnPattern();
            player.onBlock = false;

            for(let i = portals.length - 1; i >= 0; i--) {
                const p = portals[i];
                p.update();
                p.draw();
                
                if (!p.passed && player.x + player.size > p.x && player.x < p.x + p.width) {
                    if (player.y + player.size > p.y && player.y < p.y + p.height) {
                        p.passed = true;
                        
                        if (p.toMode === 'VICTORY') {
                            gameWin();
                        } else if (p.toMode === 'DIFFICULTY') {
                            let nextDiff = 'EASY';
                            if (currentDifficulty === 'EASY') nextDiff = 'MEDIUM';
                            else if (currentDifficulty === 'MEDIUM') nextDiff = 'HARD';
                            else nextDiff = 'EASY';

                            changeDifficulty(nextDiff);
                            explode(p.x + p.width/2, p.y + p.height/2, p.color, 40);
                            showBannerText("DIFFICULTÉ : " + difficultySettings[nextDiff].label.toUpperCase());
                        } else {
                            currentGameMode = p.toMode;
                            explode(p.x + p.width/2, p.y + p.height/2, p.color, 30);
                            modeIndicator.textContent = "Mode: " + (currentGameMode === 'SHIP' ? 'Vaisseau' : (player.shape === 'SHAPE_67' ? '67' : 'Cercle'));
                            modeIndicator.className = currentGameMode === 'SHIP' ? "text-xs mt-1 font-mono uppercase tracking-widest text-pink-500" : "text-xs mt-1 font-mono uppercase tracking-widest text-green-400";
                        }
                    }
                }
                if (p.x + p.width < 0) portals.splice(i, 1);
            }

            for (let i = obstacles.length - 1; i >= 0; i--) {
                const o = obstacles[i];
                o.update();
                o.draw();
                if (checkCollision(player, o)) gameOver();
                if (o.x + o.width < 0) {
                    if (!o.passed && o.type !== 'CEILING') {
                        score++;
                        scoreElement.textContent = score;
                        o.passed = true;
                    }
                    obstacles.splice(i, 1);
                }
            }
        }

        for (let i = particles.length - 1; i >= 0; i--) {
            particles[i].update();
            particles[i].draw();
            if (particles[i].life <= 0) particles.splice(i, 1);
        }

        if (gameState !== 'GAMEOVER' && gameState !== 'VICTORY') player.draw();

        if (bannerTimer > 0) {
            ctx.save();
            ctx.font = "bold 28px 'Segoe UI', sans-serif";
            ctx.fillStyle = "#ffffff";
            ctx.textAlign = "center";
            ctx.shadowBlur = 15;
            ctx.shadowColor = "#e67e22";
            ctx.fillText(bannerText, canvas.width / 2, canvas.height / 2 - 20);
            ctx.restore();
            bannerTimer--;
        }

        requestAnimationFrame(update);
    }

    function explode(x, y, color, amount = 25) {
        for (let i = 0; i < amount; i++) particles.push(new Particle(x, y, color));
    }

    function handleAction(pressed) {
        isPressing = pressed;
        if (pressed && gameState === 'PLAYING') player.jump();
    }

    window.addEventListener('keydown', (e) => {
        if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') {
            if (gameState === 'PLAYING') handleAction(true);
            else if (gameState === 'MENU' || !menuOverlay.classList.contains('hide')) resetGame();
        }
    });
    window.addEventListener('keyup', (e) => handleAction(false));
    canvas.addEventListener('mousedown', () => handleAction(true));
    window.addEventListener('mouseup', () => handleAction(false));
    canvas.addEventListener('touchstart', (e) => { 
        if (gameState === 'PLAYING') { e.preventDefault(); handleAction(true); }
    }, {passive: false});
    canvas.addEventListener('touchend', () => handleAction(false));
    startBtn.addEventListener('click', (e) => { e.stopPropagation(); resetGame(); });

    function resize() {
        canvas.width = Math.min(window.innerWidth, 1000);
        canvas.height = Math.min(window.innerHeight, 500);
    }
    window.addEventListener('resize', resize);
    resize();
    update();
</script>
</body>
</html>
